{
  "name": "ruangsetara",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validasi && npm run bundel:api && tsc --noEmit && vite build",
    "bundel:api": "esbuild server/analisis.ts --bundle --platform=node --format=esm --target=node22 --outfile=api/analisis.mjs --log-level=warning && esbuild server/denah.ts --bundle --platform=node --format=esm --target=node22 --outfile=api/denah.mjs --log-level=warning",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validasi": "tsx scripts/validasi-konten.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"server/**/*.ts\" \"*.{ts,js,json}\"",
    "format:cek": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"server/**/*.ts\" \"*.{ts,js,json}\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
